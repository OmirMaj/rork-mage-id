# To remove existing tracked copies, run:
#   git rm -rf expo bundles FULL_EXPORT.txt FULL_SOURCE_EXPORT.txt \
#              QA_AUDIT_EXPORT.txt export_part_* sentry-wizard-installation-error-*.log
# Then commit. The .gitignore entries below prevent re-adds.

