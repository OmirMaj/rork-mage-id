  "entries": [
    {
      "file": "app/notifications-settings.tsx",
      "rule": "R11",
      "match": "digestTimezone.split('/').pop()?.replace(/_/g, ' ')",
      "reason": "IANA time-zone city (America/New_York -> New York), not a status enum"
    },
    {
      "file": "app/cost-xray.tsx",
      "rule": "R09",
      "match": "setError(`${String((e as Error)?.message ?? '')} Your photos are saved to the project.`);",
      "reason": "the analyze-photos function's own coded sentence (hourly_limit), written for the contractor"
    },
    {
      "file": "app/drawing-analyzer.tsx",
      "rule": "R09",
      "match": "setError(limit.message ?? 'Daily limit reached. Try again tomorrow.');",
      "reason": "limit.message is the authored sentence from utils/aiRateLimiter, not an exception"
    },
    {
      "file": "components/AIHomeBriefing.tsx",
      "rule": "R09",
      "match": "setError(limit.message ??",
      "reason": "limit.message is the authored sentence from utils/aiRateLimiter, not an exception"
    },
    {
      "file": "app/business.tsx",
      "rule": "R16",
      "match": "avg lost to weather",
      "reason": "caption that finishes a number (\"3.2d avg lost to weather\"), VOICE 3"
    },
    {
      "file": "components/takeoff/TakeoffFirstRun.tsx",
      "rule": "R16",
      "match": "or drop a PDF here",
      "reason": "continuation of the Upload plans button above it (pinned by validate-takeoff-pdf-drop)"
    },
    {
      "file": "components/priceWatch/PriceWatchCard.tsx",
      "rule": "R16",
      "match": "and 0 more",
      "reason": "list continuation (\"and 3 more\") under the rows above"
    },
    {
      "file": "components/plans/AskPlansPanel.tsx",
      "rule": "R15",
      "match": "Ask Your Plans",
      "reason": "renamed atomically with the paywall, featureRegistry and 5 validators in copy handoff B1"
    }
  ]
