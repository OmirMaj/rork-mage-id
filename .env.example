# MAGE ID — environment variable template.
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this template is committed.
#
# All EXPO_PUBLIC_* vars are baked into the JS bundle at build time —
# they're visible in the shipped app, so only put values here that are
# safe to expose (publishable keys, public ingestion endpoints).
# Secret values (Stripe secret keys, Supabase service role keys) live
# in the Supabase edge function environment, never in this file.

# PostHog — product analytics. Project key (phc_) is public-safe.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
