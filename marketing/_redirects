# Route all /portal/* URLs (any portal ID) to the homeowner portal page.
/portal/*  /portal/index.html  200

# Route all /sub-portal/* URLs to the subcontractor portal page. The
# portalId is in the path; the snapshot is in the URL hash, which is
# never sent to the server.
/sub-portal/*  /sub-portal/index.html  200

# Catch-all 404 (marketing-audit M3). Was previously `/* /index.html 200` —
# unknown URLs got served the homepage with status 200, which hurt SEO
# (search engines couldn't drop dead URLs from the index) and UX (typos
# silently served the homepage). Now: unknown paths serve /404.html with
# real 404 status. Netlify still serves any directly-existing file
# (/features/financials.html, /pricing.html, etc.) before this catch-all
# triggers, so this only fires on genuinely unknown paths.
/*  /404.html  404
